'use client'

import { useEffect, useState, useCallback } from 'react'
import Link from 'next/link'
import { UserButton, useUser } from '@clerk/nextjs'
import { supabase } from '@/lib/supabase'
import './dashboard.css'

// Types
interface UserStats {
    level: number
    xp: number
    xp_to_next: number
    streak: number
    lives: number
    rank: string
}

interface Mission {
    id: string
    title: string
    description: string
    target_value: number
    current_value: number
    unit: string
}

interface Chapter {
    id: string
    number: number
    title: string
    progress: number
    objectives: Objective[]
}

interface Objective {
    id: string
    title: string
    level: string
    status: 'completed' | 'active' | 'pending'
    progress: number
    current_value?: number
    target_value?: number
}

interface ActiveTask {
    id: string
    title: string
    description: string
    chapter_title: string
    xp_reward: number
    difficulty: string
    estimated_time: string
    materials: Material[]
}

interface Material {
    id: string
    title: string
    description: string
    type: string
    emoji: string
}

interface JournalEntry {
    id: string
    title: string
    content: string
    entry_type: string
}

// Rank thresholds
const RANKS = [
    { level: 1, name: '🌱 Seme', minXp: 0 },
    { level: 5, name: '🚶 Viaggiatore', minXp: 5000 },
    { level: 10, name: '⚔️ Guerriero', minXp: 15000 },
    { level: 20, name: '🦅 Esploratore', minXp: 50000 },
    { level: 35, name: '👑 Maestro', minXp: 150000 },
    { level: 50, name: '🌟 Leggenda', minXp: 500000 },
]

function getRank(level: number): string {
    for (let i = RANKS.length - 1; i >= 0; i--) {
        if (level >= RANKS[i].level) return RANKS[i].name
    }
    return RANKS[0].name
}

function getXpForLevel(level: number): number {
    return Math.floor(1000 * Math.pow(1.15, level - 1))
}

export default function DashboardPage() {
    const { user, isLoaded } = useUser()
    const [stats, setStats] = useState<UserStats>({
        level: 1,
        xp: 0,
        xp_to_next: 1000,
        streak: 0,
        lives: 3,
        rank: '🌱 Seme'
    })
    const [mission, setMission] = useState<Mission | null>(null)
    const [currentChapter, setCurrentChapter] = useState<Chapter | null>(null)
    const [activeTask, setActiveTask] = useState<ActiveTask | null>(null)
    const [materials, setMaterials] = useState<JournalEntry[]>([])
    const [loading, setLoading] = useState(true)
    const [activePanel, setActivePanel] = useState<string | null>(null)
    const [taskNotes, setTaskNotes] = useState('')
    const [showModal, setShowModal] = useState(false)
    const [modalData, setModalData] = useState({ xp: 0, streak: 0 })

    // Load all data
    const loadData = useCallback(async () => {
        if (!user) return

        try {
            // Load user stats
            const { data: statsData } = await supabase
                .from('user_stats')
                .select('*')
                .eq('clerk_user_id', user.id)
                .maybeSingle()

            if (statsData) {
                const level = statsData.level || 1
                const xpToNext = getXpForLevel(level)
                setStats({
                    level,
                    xp: statsData.xp || 0,
                    xp_to_next: xpToNext,
                    streak: statsData.streak || 0,
                    lives: statsData.lives ?? 3,
                    rank: getRank(level)
                })
            }

            // Load mission
            const { data: missionData } = await supabase
                .from('user_mission')
                .select('*')
                .eq('clerk_user_id', user.id)
                .eq('status', 'active')
                .maybeSingle()

            if (missionData) {
                setMission(missionData)

                // Load objectives for current chapter
                const { data: objectives } = await supabase
                    .from('objectives')
                    .select('*')
                    .eq('clerk_user_id', user.id)
                    .eq('mission_id', missionData.id)
                    .order('sort_order')

                if (objectives && objectives.length > 0) {
                    // Find current active objective for task
                    const activeObj = objectives.find(o => o.status === 'active') || objectives[0]

                    // Group into chapter
                    const majorObjs = objectives.filter(o => o.level === 'major')
                    const currentMajorIndex = majorObjs.findIndex(o => o.status === 'active' || o.status === 'pending')
                    const chapterNum = currentMajorIndex >= 0 ? currentMajorIndex + 1 : majorObjs.length

                    setCurrentChapter({
                        id: 'chapter-' + chapterNum,
                        number: chapterNum,
                        title: majorObjs[Math.max(0, currentMajorIndex)]?.title || 'Il Viaggio',
                        progress: Math.round(objectives.filter(o => o.status === 'completed').length / objectives.length * 100),
                        objectives: objectives.map(o => ({
                            ...o,
                            status: o.status as 'completed' | 'active' | 'pending'
                        }))
                    })

                    // Set active task
                    if (activeObj) {
                        setActiveTask({
                            id: activeObj.id,
                            title: activeObj.title,
                            description: activeObj.description || 'Completa questa task per avanzare nel tuo viaggio.',
                            chapter_title: `Capitolo ${chapterNum}`,
                            xp_reward: activeObj.level === 'major' ? 150 : activeObj.level === 'sub' ? 90 : 50,
                            difficulty: activeObj.level === 'major' ? 'Alta' : activeObj.level === 'sub' ? 'Media' : 'Facile',
                            estimated_time: activeObj.level === 'major' ? '~1 ora' : activeObj.level === 'sub' ? '~30 min' : '~15 min',
                            materials: []
                        })
                    }
                }
            }

            // Load materials for scrivania
            const { data: materialsData } = await supabase
                .from('journal_entries')
                .select('*')
                .eq('clerk_user_id', user.id)
                .in('entry_type', ['guide', 'resource', 'article', 'document'])
                .order('created_at', { ascending: false })
                .limit(5)

            if (materialsData) {
                setMaterials(materialsData)
            }

            // Load saved notes
            const savedNotes = localStorage.getItem(`task_notes_${user.id}`)
            if (savedNotes) setTaskNotes(savedNotes)

        } catch (error) {
            console.error('Error loading data:', error)
        } finally {
            setLoading(false)
        }
    }, [user])

    useEffect(() => {
        if (isLoaded && user) {
            loadData()
        } else if (isLoaded && !user) {
            setLoading(false)
        }
    }, [isLoaded, user, loadData])

    // Complete task
    const completeTask = async () => {
        if (!user || !activeTask) return

        const xpGained = activeTask.xp_reward
        const newStreak = stats.streak + 1

        // Update objective status
        await supabase
            .from('objectives')
            .update({
                status: 'completed',
                progress: 100,
                completed_at: new Date().toISOString()
            })
            .eq('id', activeTask.id)

        // Update or create user stats
        const newXp = stats.xp + xpGained
        let newLevel = stats.level
        let remainingXp = newXp

        // Check level up
        while (remainingXp >= getXpForLevel(newLevel)) {
            remainingXp -= getXpForLevel(newLevel)
            newLevel++
        }

        await supabase
            .from('user_stats')
            .upsert({
                clerk_user_id: user.id,
                level: newLevel,
                xp: newXp,
                streak: newStreak,
                lives: stats.lives,
                last_activity: new Date().toISOString()
            }, { onConflict: 'clerk_user_id' })

        // Show modal
        setModalData({ xp: xpGained, streak: newStreak })
        setShowModal(true)

        // Reload data
        loadData()
    }

    // Skip task
    const skipTask = async () => {
        if (!user || stats.lives <= 0) {
            alert('Non hai più vite! Completa una task per guadagnarne.')
            return
        }

        if (!confirm('⚠️ Saltare costa 1 vita. Confermi?')) return

        await supabase
            .from('user_stats')
            .upsert({
                clerk_user_id: user.id,
                lives: stats.lives - 1,
                last_activity: new Date().toISOString()
            }, { onConflict: 'clerk_user_id' })

        // Mark as skipped, find next
        if (activeTask) {
            await supabase
                .from('objectives')
                .update({ status: 'pending' })
                .eq('id', activeTask.id)
        }

        loadData()
    }

    // Save notes
    const saveNotes = () => {
        if (user) {
            localStorage.setItem(`task_notes_${user.id}`, taskNotes)
            alert('✅ Note salvate!')
        }
    }

    // Toggle panel
    const togglePanel = (panel: string) => {
        setActivePanel(activePanel === panel ? null : panel)
    }

    // Calculate mission progress
    const missionProgress = mission
        ? Math.round(((mission.current_value || 0) / (mission.target_value || 1)) * 100)
        : 0

    // XP progress for current level
    const xpProgress = Math.round((stats.xp % stats.xp_to_next) / stats.xp_to_next * 100)

    if (!isLoaded || loading) {
        return (
            <div className="dashboard-page">
                <div className="bg-ambient"></div>
                <div className="loading-state">
                    <div className="spinner"></div>
                    <p>Caricamento...</p>
                </div>
            </div>
        )
    }

    if (!user) {
        return (
            <div className="dashboard-page">
                <div className="bg-ambient"></div>
                <div className="auth-prompt">
                    <div className="auth-icon">🎮</div>
                    <h1>Il Gioco della Vita</h1>
                    <p>Accedi per iniziare il tuo viaggio</p>
                    <Link href="/" className="btn-primary">Vai alla Home</Link>
                </div>
            </div>
        )
    }

    return (
        <div className="dashboard-page">
            <div className="bg-ambient"></div>

            {/* Top Bar */}
            <header className="topbar">
                <div className="topbar-inner">
                    <div className="player">
                        <div className="level-badge" style={{ '--progress': xpProgress } as React.CSSProperties}>
                            <div className="level-ring"></div>
                            <div className="level-inner">
                                <span className="level-num">{stats.level}</span>
                            </div>
                        </div>
                        <div className="player-info">
                            <div className="player-rank">{stats.rank}</div>
                            <div className="xp-row">
                                <div className="xp-bar">
                                    <div className="xp-fill" style={{ width: `${xpProgress}%` }}></div>
                                </div>
                                <span className="xp-text">
                                    {stats.xp.toLocaleString()} / {stats.xp_to_next.toLocaleString()}
                                </span>
                            </div>
                        </div>
                    </div>

                    <div className="stats-row">
                        <div className="streak">
                            <span>🔥</span>
                            <span>{stats.streak}</span>
                        </div>
                        <div className="lives">
                            {[...Array(3)].map((_, i) => (
                                <span key={i} className={`heart ${i >= stats.lives ? 'dead' : ''}`}>❤️</span>
                            ))}
                        </div>
                        <UserButton afterSignOutUrl="/" />
                    </div>
                </div>
            </header>

            {/* Main */}
            <main className="main-content">
                {/* Task Section */}
                {activeTask ? (
                    <div className="task-section">
                        <div className="task-hero">
                            <div className="task-meta">
                                <div className="task-badge">
                                    <span className="dot"></span>
                                    <span>Task Attiva</span>
                                </div>
                                <span className="task-chapter">📍 {activeTask.chapter_title}</span>
                            </div>

                            <h1 className="task-title">{activeTask.title}</h1>
                            <p className="task-desc">{activeTask.description}</p>

                            <div className="task-rewards">
                                <div className="reward xp">✨ +{activeTask.xp_reward} XP</div>
                                <div className="reward">⚔️ {activeTask.difficulty}</div>
                                <div className="reward">⏱️ {activeTask.estimated_time}</div>
                            </div>

                            <div className="task-actions">
                                <button className="btn btn-complete" onClick={completeTask}>
                                    ✓ HO FINITO
                                </button>
                                <button className="btn btn-ghost" onClick={skipTask}>
                                    Salta →
                                </button>
                                <Link href="/chat" className="btn btn-nur">
                                    💬 Chiedi a NUR
                                </Link>
                            </div>
                        </div>

                        {/* Panels Tabs */}
                        <div className="panels-tabs">
                            <button
                                className={`panel-tab ${activePanel === 'desk' ? 'active' : ''}`}
                                onClick={() => togglePanel('desk')}
                            >
                                <span className="icon">🗂️</span>
                                <span>Scrivania</span>
                            </button>
                            <button
                                className={`panel-tab ${activePanel === 'dashboard' ? 'active' : ''}`}
                                onClick={() => togglePanel('dashboard')}
                            >
                                <span className="icon">📊</span>
                                <span>Dashboard</span>
                            </button>
                            <button
                                className={`panel-tab ${activePanel === 'notes' ? 'active' : ''}`}
                                onClick={() => togglePanel('notes')}
                            >
                                <span className="icon">📝</span>
                                <span>Note</span>
                            </button>
                        </div>

                        {/* Panel: Scrivania */}
                        {activePanel === 'desk' && (
                            <div className="panel-content">
                                <div className="desk-section">
                                    <div className="desk-title">📄 Materiali</div>
                                    <div className="materials-list">
                                        {materials.length > 0 ? materials.map(m => (
                                            <Link
                                                key={m.id}
                                                href="/giornale"
                                                className="material-item"
                                            >
                                                <div className="material-icon">
                                                    {m.entry_type === 'guide' ? '📋' :
                                                     m.entry_type === 'article' ? '📰' :
                                                     m.entry_type === 'resource' ? '🔗' : '📄'}
                                                </div>
                                                <div className="material-info">
                                                    <div className="material-name">{m.title || 'Senza titolo'}</div>
                                                    <div className="material-desc">
                                                        {m.content?.slice(0, 50)}...
                                                    </div>
                                                </div>
                                                <div className="material-action">Apri →</div>
                                            </Link>
                                        )) : (
                                            <div className="empty-materials">
                                                <p>Nessun materiale ancora</p>
                                                <Link href="/chat" className="btn btn-ghost">
                                                    💬 Chiedi a NUR
                                                </Link>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>
                        )}

                        {/* Panel: Dashboard */}
                        {activePanel === 'dashboard' && (
                            <div className="panel-content">
                                <div className="dash-grid">
                                    <div className="dash-stat">
                                        <div className="dash-stat-label">Task Completate</div>
                                        <div className="dash-stat-value">
                                            {currentChapter?.objectives.filter(o => o.status === 'completed').length || 0}
                                        </div>
                                        <div className="dash-stat-sub">In questo capitolo</div>
                                    </div>
                                    <div className="dash-stat">
                                        <div className="dash-stat-label">XP Totali</div>
                                        <div className="dash-stat-value">{stats.xp.toLocaleString()}</div>
                                        <div className="dash-stat-sub">Livello {stats.level}</div>
                                    </div>
                                    <div className="dash-stat">
                                        <div className="dash-stat-label">Streak</div>
                                        <div className="dash-stat-value">🔥 {stats.streak}</div>
                                        <div className="dash-stat-sub">Giorni consecutivi</div>
                                    </div>
                                    <div className="dash-stat">
                                        <div className="dash-stat-label">Missione</div>
                                        <div className="dash-stat-value">{missionProgress}%</div>
                                        <div className="dash-stat-sub">{mission?.title || 'Non impostata'}</div>
                                    </div>
                                </div>
                            </div>
                        )}

                        {/* Panel: Notes */}
                        {activePanel === 'notes' && (
                            <div className="panel-content">
                                <textarea
                                    className="notes-area"
                                    placeholder="Scrivi qui le tue note per questa task..."
                                    value={taskNotes}
                                    onChange={(e) => setTaskNotes(e.target.value)}
                                />
                                <div className="notes-actions">
                                    <button className="btn btn-ghost" onClick={saveNotes}>
                                        💾 Salva Note
                                    </button>
                                </div>
                            </div>
                        )}
                    </div>
                ) : (
                    <div className="no-task-section">
                        <div className="empty-icon">🎯</div>
                        <h2>Nessuna task attiva</h2>
                        <p>Parla con NUR per definire la tua missione e iniziare il viaggio!</p>
                        <Link href="/chat" className="btn btn-nur">
                            💬 Parla con NUR
                        </Link>
                    </div>
                )}

                {/* Grid */}
                <div className="cards-grid">
                    {/* Chapter Progress */}
                    {currentChapter && (
                        <div className="card">
                            <div className="card-header">
                                <div>
                                    <div className="card-label">Capitolo {currentChapter.number}</div>
                                    <div className="card-title">{currentChapter.title}</div>
                                </div>
                                <div className="card-value">{currentChapter.progress}%</div>
                            </div>

                            <div className="progress-bar">
                                <div className="progress-bar-fill" style={{ width: `${currentChapter.progress}%` }}></div>
                            </div>

                            <div className="objectives">
                                {currentChapter.objectives.slice(0, 5).map(obj => (
                                    <div key={obj.id} className="obj-item">
                                        <div className={`obj-check ${obj.status === 'completed' ? 'done' : obj.status === 'active' ? 'current' : 'locked'}`}>
                                            {obj.status === 'completed' ? '✓' : obj.status === 'active' ? '●' : '🔒'}
                                        </div>
                                        <span className={`obj-text ${obj.status}`}>{obj.title}</span>
                                        {obj.status === 'active' && obj.target_value && (
                                            <span className="obj-count">
                                                {obj.current_value || 0}/{obj.target_value}
                                            </span>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* Journey */}
                    <div className="card">
                        <div className="card-header">
                            <div>
                                <div className="card-label">Il tuo</div>
                                <div className="card-title">Viaggio</div>
                            </div>
                        </div>

                        <div className="journey">
                            <div className="journey-line"></div>
                            <div className="journey-fill" style={{ width: `${Math.min(80, missionProgress)}%` }}></div>

                            {[1, 2, 3, 4, 5].map(n => {
                                const threshold = (n - 1) * 25
                                const isDone = missionProgress > threshold
                                const isCurrent = missionProgress >= threshold && missionProgress < threshold + 25
                                return (
                                    <div
                                        key={n}
                                        className={`journey-node ${isDone && !isCurrent ? 'done' : isCurrent ? 'current' : 'locked'}`}
                                    >
                                        {isDone && !isCurrent ? '✓' : isCurrent ? n : n === 5 ? '?' : n}
                                    </div>
                                )
                            })}
                        </div>
                    </div>
                </div>

                {/* Mission */}
                {mission && (
                    <div className="mission-card">
                        <div className="mission-icon">🎯</div>
                        <div className="mission-label">Destinazione Finale</div>
                        <div className="mission-title">{mission.title}</div>
                        <div className="mission-sub">
                            {mission.current_value?.toLocaleString() || 0} / {mission.target_value?.toLocaleString() || '?'} {mission.unit || ''}
                        </div>
                        <div className="mission-progress">
                            <div className="mission-progress-fill" style={{ width: `${missionProgress}%` }}></div>
                        </div>
                        <div className="mission-pct">{missionProgress}%</div>
                    </div>
                )}
            </main>

            {/* Bottom Nav */}
            <nav className="bottom-nav">
                <Link href="/la-mia-vita" className="nav-item active">
                    <span className="nav-icon">📖</span>
                    <span className="nav-label">Storia</span>
                </Link>
                <Link href="/chat" className="nav-item">
                    <span className="nav-icon">💬</span>
                    <span className="nav-label">NUR</span>
                </Link>
                <Link href="/giornale" className="nav-item">
                    <span className="nav-icon">📚</span>
                    <span className="nav-label">Scrivania</span>
                </Link>
            </nav>

            {/* Modal */}
            {showModal && (
                <div className="modal-overlay" onClick={() => setShowModal(false)}>
                    <div className="modal" onClick={e => e.stopPropagation()}>
                        <div className="modal-emoji">🎉</div>
                        <h2 className="modal-title">Task Completata!</h2>
                        <div className="modal-xp">+{modalData.xp} XP</div>
                        <div className="modal-streak">🔥 Streak: {modalData.streak} giorni!</div>
                        <button className="modal-btn" onClick={() => setShowModal(false)}>
                            Continua →
                        </button>
                    </div>
                </div>
            )}
        </div>
    )
}
