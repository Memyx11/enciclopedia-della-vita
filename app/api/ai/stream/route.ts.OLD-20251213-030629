const ACTION_KEYWORDS = [
    'salva', 'salvami', 'crea', 'creami', 'aggiungi', 'aggiungimi',
    'metti', 'mettimi', 'scrivi', 'scrivimi', 'genera', 'generami',
    'task', 'traguardo', 'traguardi', 'obiettivo', 'obiettivi',
