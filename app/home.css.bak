/* ═══════════════════════════════════════════════════════════════
   ENCICLOPEDIA DELLA VITA - HOME PAGE
   Design originale con dropdown e sezioni
   ═══════════════════════════════════════════════════════════════ */

:root {
    --primary: #667eea;
    --primary-dark: #764ba2;
    --accent: #f093fb;
    --bg-dark: #0a0a0a;
    --bg-card: rgba(26, 26, 46, 0.6);
    --text: #e0e0e0;
    --text-muted: #a0a0a0;
}

.home-container {
    min-height: 100vh;
    background: var(--bg-dark);
    color: var(--text);
}

.bg-gradient {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: 
        radial-gradient(ellipse at 20% 20%, rgba(102, 126, 234, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, rgba(118, 75, 162, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 50%, rgba(240, 147, 251, 0.05) 0%, transparent 70%);
    z-index: 0;
    pointer-events: none;
}

/* === HEADER === */
.main-header {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(102, 126, 234, 0.3);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.header-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 18px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.4em;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
}

.nav-buttons {
    display: flex;
    gap: 12px;
    align-items: center;
}

.user-greeting {
    color: var(--text-muted);
    font-size: 0.9em;
}

.btn {
    padding: 10px 22px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9em;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
}

.btn-ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid rgba(255,255,255,0.2);
}

.btn-ghost:hover {
    background: rgba(255,255,255,0.1);
    border-color: var(--primary);
}

.btn-large {
    padding: 14px 30px;
    font-size: 1em;
}

/* === NAVIGATION === */
.main-nav {
    background: rgba(17, 17, 17, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    position: relative;
    z-index: 999;
}

.nav-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
}

.nav-content::-webkit-scrollbar { display: none; }

.nav-item {
    position: relative;
    padding: 14px 22px;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s;
    border-bottom: 2px solid transparent;
    font-size: 0.95em;
}

.nav-item:hover {
    color: var(--text);
    background: rgba(102, 126, 234, 0.1);
    border-bottom-color: var(--primary);
}

.dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: rgba(26, 26, 30, 0.98);
    backdrop-filter: blur(20px);
    min-width: 280px;
    box-shadow: 0 15px 50px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    overflow: hidden;
    z-index: 1000;
    animation: slideDown 0.2s ease;
}

@keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

.dropdown-section {
    padding: 15px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.dropdown-section:last-child { border-bottom: none; }

.dropdown-title {
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 10px;
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.dropdown-item {
    padding: 10px 15px;
    color: var(--text-muted);
    text-decoration: none;
    display: block;
    border-radius: 8px;
    transition: all 0.2s;
}

.dropdown-item:hover {
    background: rgba(102, 126, 234, 0.2);
    color: white;
}

/* === HERO === */
.hero {
    position: relative;
    z-index: 5;
    padding: 80px 40px;
    text-align: center;
    max-width: 1000px;
    margin: 0 auto;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(102, 126, 234, 0.15);
    border: 1px solid rgba(102, 126, 234, 0.3);
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 0.85em;
    color: var(--primary);
    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(2.2em, 5vw, 3.5em);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
    color: white;
}

.hero h1 em {
    font-style: italic;
    font-weight: 300;
}

.gradient-text {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    font-size: 1.15em;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 35px;
}

/* === SEARCH === */
.search-container {
    max-width: 700px;
    margin: 0 auto 35px;
}

.search-input {
    width: 100%;
    padding: 18px 25px;
    background: rgba(26, 26, 46, 0.8);
    border: 2px solid rgba(102, 126, 234, 0.3);
    border-radius: 15px;
    color: white;
    font-size: 1em;
    transition: all 0.3s;
}

.search-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 20px rgba(102, 126, 234, 0.2);
}

.search-input::placeholder {
    color: var(--text-muted);
}

/* === HERO CTA === */
.hero-cta {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
}

/* === CONTENT SECTIONS === */
.content-section {
    position: relative;
    z-index: 5;
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px;
}

.section-header {
    margin-bottom: 40px;
}

.section-badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 0.75em;
    font-weight: 700;
    letter-spacing: 1px;
    color: white;
    margin-bottom: 15px;
}

.section-title {
    font-size: 2em;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 10px;
}

.section-subtitle {
    color: var(--text-muted);
    font-size: 1.05em;
}

/* === CARDS === */
.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 25px;
}

.content-card {
    background: rgba(26, 26, 46, 0.6);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 30px;
    text-decoration: none;
    transition: all 0.3s;
}

.content-card:hover {
    border-color: var(--primary);
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
}

.content-card h3 {
    color: var(--primary);
    font-size: 1.3em;
    font-weight: 700;
    margin-bottom: 18px;
}

.content-card ul {
    list-style: none;
}

.content-card li {
    padding: 10px 0;
    color: var(--text);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    font-size: 0.95em;
    transition: all 0.2s;
}

.content-card li:last-child {
    border-bottom: none;
}

.content-card:hover li {
    color: white;
}

/* === CTA SECTION === */
.cta-section {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 80px 40px;
    background: linear-gradient(180deg, transparent, rgba(102, 126, 234, 0.1));
}

.cta-section h2 {
    font-size: 2.2em;
    color: white;
    margin-bottom: 15px;
}

.cta-section p {
    color: var(--text-muted);
    font-size: 1.1em;
    margin-bottom: 30px;
    line-height: 1.6;
}

/* === FOOTER === */
.main-footer {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 40px;
    border-top: 1px solid rgba(255,255,255,0.05);
    color: var(--text-muted);
    font-size: 0.9em;
}

/* === CHAT FAB === */
.chat-fab {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 65px;
    height: 65px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6em;
    box-shadow: 0 8px 30px rgba(102, 126, 234, 0.5);
    z-index: 1000;
    transition: all 0.3s;
    text-decoration: none;
}

.chat-fab:hover {
    transform: scale(1.1);
    box-shadow: 0 12px 40px rgba(102, 126, 234, 0.6);
}

/* === RESPONSIVE === */
@media (max-width: 768px) {
    .header-content {
        padding: 15px 20px;
    }
    
    .logo {
        font-size: 1.1em;
    }
    
    .hero {
        padding: 50px 20px;
    }
    
    .hero h1 {
        font-size: 2em;
    }
    
    .content-section {
        padding: 40px 20px;
    }
    
    .cards-grid {
        grid-template-columns: 1fr;
    }
    
    .hero-cta {
        flex-direction: column;
        align-items: center;
    }
    
    .btn-large {
        width: 100%;
        justify-content: center;
    }
}
