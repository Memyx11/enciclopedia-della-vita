:root {
    --primary: #667eea;
    --primary-dark: #764ba2;
    --accent: #f093fb;
    --bg-dark: #0a0a0a;
    --bg-card: rgba(26, 26, 46, 0.6);
    --text: #e0e0e0;
    --text-muted: #a0a0a0;
}

.bg-gradient {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: 
        radial-gradient(ellipse at 20% 20%, rgba(102, 126, 234, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, rgba(118, 75, 162, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 50%, rgba(240, 147, 251, 0.05) 0%, transparent 70%);
    z-index: -1;
}

header {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(102, 126, 234, 0.3);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.header-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 18px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.4em;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
}

.nav-buttons { display: flex; gap: 12px; align-items: center; }

.btn {
    padding: 10px 22px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9em;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    border: none;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
}

.btn-ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid rgba(255,255,255,0.2);
}

.btn-ghost:hover {
    background: rgba(255,255,255,0.1);
    border-color: var(--primary);
}

nav {
    background: rgba(17, 17, 17, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.nav-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
}

.nav-content::-webkit-scrollbar { display: none; }

.nav-item {
    position: relative;
    padding: 14px 22px;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s;
    border-bottom: 2px solid transparent;
    font-size: 0.95em;
}

.nav-item:hover {
    color: var(--text);
    background: rgba(102, 126, 234, 0.1);
    border-bottom-color: var(--primary);
}

.dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: rgba(26, 26, 30, 0.98);
    backdrop-filter: blur(20px);
    min-width: 280px;
    display: none;
    box-shadow: 0 15px 50px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    overflow: hidden;
    z-index: 999;
}

.nav-item:hover .dropdown { display: block; }

.dropdown-section {
    padding: 15px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.dropdown-section:last-child { border-bottom: none; }

.dropdown-title {
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 10px;
    font-size: 0.8em;
    text-transform: uppercase;
}

.dropdown-item {
    padding: 10px 15px;
    color: var(--text-muted);
    text-decoration: none;
    display: block;
    border-radius: 8px;
    transition: all 0.2s;
}

.dropdown-item:hover {
    background: rgba(102, 126, 234, 0.2);
    color: white;
}

.hero {
    padding: 80px 40px;
    text-align: center;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(102, 126, 234, 0.15);
    border: 1px solid rgba(102, 126, 234, 0.3);
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 0.85em;
    color: var(--primary);
    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(2.2em, 5vw, 3.5em);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
    background: linear-gradient(135deg, #fff 0%, var(--text) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero p {
    font-size: 1.15em;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 35px;
    line-height: 1.6;
}

.search-box {
    max-width: 600px;
    margin: 0 auto 30px;
}

.search-box input {
    width: 100%;
    padding: 18px 25px;
    font-size: 1em;
    background: rgba(26, 26, 30, 0.8);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50px;
    color: var(--text);
    outline: none;
    transition: all 0.3s;
}

.search-box input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 30px rgba(102, 126, 234, 0.2);
}

.search-box input::placeholder { color: #666; }

.hero-cta {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
}

.main-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 40px 80px;
}

.priority-section { margin-bottom: 70px; }

.priority-label {
    display: inline-block;
    padding: 6px 14px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    border-radius: 20px;
    font-size: 0.75em;
    font-weight: 700;
    margin-bottom: 15px;
    text-transform: uppercase;
}

.section-title {
    font-size: 2em;
    color: var(--primary);
    margin-bottom: 10px;
}

.section-description {
    font-size: 1em;
    color: var(--text-muted);
    margin-bottom: 25px;
}

.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
}

.card {
    background: var(--bg-card);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 28px;
    transition: all 0.3s;
}

.card:hover {
    transform: translateY(-4px);
    border-color: rgba(102, 126, 234, 0.4);
    box-shadow: 0 15px 40px rgba(102, 126, 234, 0.15);
}

.card-title {
    font-size: 1.3em;
    color: var(--primary);
    margin-bottom: 18px;
    font-weight: 600;
}

.card-items { list-style: none; }

.card-items li {
    padding: 10px 0;
    color: var(--text-muted);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: all 0.2s;
}

.card-items li:last-child { border-bottom: none; }
.card-items li:hover { color: var(--primary); }
.card-items li a { color: inherit; text-decoration: none; }

.cta-section {
    padding: 80px 40px;
    text-align: center;
    background: rgba(0,0,0,0.3);
}

.cta-box {
    max-width: 650px;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.15), rgba(118, 75, 162, 0.15));
    border: 1px solid rgba(102, 126, 234, 0.3);
    border-radius: 24px;
    padding: 50px 35px;
}

.cta-box h2 { font-size: 1.8em; margin-bottom: 12px; color: white; }
.cta-box p { color: var(--text-muted); margin-bottom: 25px; }

footer {
    background: rgba(0,0,0,0.8);
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 35px;
    text-align: center;
}

footer p { color: var(--text-muted); font-size: 0.9em; }

@media (max-width: 768px) {
    .header-content { padding: 15px 20px; }
    .hero { padding: 50px 20px; }
    .main-content { padding: 40px 20px 60px; }
    .cards-grid { grid-template-columns: 1fr; }
}
